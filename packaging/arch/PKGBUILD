# Package-local recipe. Stage checksummed sources with packaging/arch/build.sh.
pkgname=aco-arch-dotfiles-wallpaper
pkgver=0.3.0
pkgrel=1
pkgdesc='Multi-monitor wallpaper CLI and defaults'
arch=('any')
url='https://github.com/Akademie-Olympia/aco-arch-dotfiles'
license=('LicenseRef-arch-dotfiles-bundle')
depends=('aco-arch-dotfiles-core>=0.3.0' 'hyprpaper' 'fuzzel' 'jq' 'findutils' 'util-linux')
optdepends=()
replaces=('arch-dotfiles-wallpaper')
conflicts=('arch-dotfiles-wallpaper')
options=('!strip')
source=('payload.tar.gz')
sha256sums=('__SOURCE_SHA256__')

package() {
    cp -a "$srcdir/usr" "$pkgdir/"
}
