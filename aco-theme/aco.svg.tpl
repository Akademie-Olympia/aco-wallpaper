<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by aco-theme from ~/.config/wallpaper/aco-theme/aco.svg.tpl. Do not edit.
     The default ACO background (licence-free, made here): a calm diagonal gradient with
     three soft glows in the accent and two palette colours, and a faint grain that hides
     colour banding in the gradients. wallpaper.sh turns it into a PNG. -->
<svg xmlns="http://www.w3.org/2000/svg" width="3840" height="2160" viewBox="0 0 3840 2160">
  <defs>
    <linearGradient id="base" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="{{bg_alt}}"/>
      <stop offset="1" stop-color="{{bg}}"/>
    </linearGradient>
    <radialGradient id="glow-accent" cx="0.2" cy="0.25" r="0.6">
      <stop offset="0" stop-color="{{accent}}" stop-opacity="0.32"/>
      <stop offset="0.6" stop-color="{{accent}}" stop-opacity="0.08"/>
      <stop offset="1" stop-color="{{accent}}" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="glow-purple" cx="0.85" cy="0.8" r="0.65">
      <stop offset="0" stop-color="{{purple}}" stop-opacity="0.24"/>
      <stop offset="0.6" stop-color="{{purple}}" stop-opacity="0.06"/>
      <stop offset="1" stop-color="{{purple}}" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="glow-cyan" cx="0.7" cy="0.12" r="0.45">
      <stop offset="0" stop-color="{{cyan}}" stop-opacity="0.14"/>
      <stop offset="1" stop-color="{{cyan}}" stop-opacity="0"/>
    </radialGradient>
    <filter id="grain" x="0" y="0" width="100%" height="100%">
      <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="1" stitchTiles="stitch"/>
      <feColorMatrix type="saturate" values="0"/>
    </filter>
  </defs>
  <rect width="3840" height="2160" fill="url(#base)"/>
  <rect width="3840" height="2160" fill="url(#glow-accent)"/>
  <rect width="3840" height="2160" fill="url(#glow-purple)"/>
  <rect width="3840" height="2160" fill="url(#glow-cyan)"/>
  <rect width="3840" height="2160" filter="url(#grain)" opacity="0.045"/>
</svg>
