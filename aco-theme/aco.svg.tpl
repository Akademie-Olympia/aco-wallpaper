<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by aco-theme from ~/.config/wallpaper/aco-theme/aco.svg.tpl. Do not edit.
     The default ACO background (licence-free, made here): layered waves in the accent
     and two palette colours over a calm gradient, each wave shaded towards its foot for
     depth, with a faint highlight along the crests and a fine grain that hides colour
     banding. The top edge stays quiet so the transparent bar reads well. It follows
     light/dark and the accent; wallpaper.sh turns it into a PNG. -->
<svg xmlns="http://www.w3.org/2000/svg" width="3840" height="2160" viewBox="0 0 3840 2160">
  <defs>
    <linearGradient id="base" x1="0" y1="0" x2="0.35" y2="1">
      <stop offset="0" stop-color="{{bg_alt}}"/>
      <stop offset="1" stop-color="{{bg}}"/>
    </linearGradient>
    <radialGradient id="glow" cx="0.8" cy="0.45" r="0.55">
      <stop offset="0" stop-color="{{pink}}" stop-opacity="0.2"/>
      <stop offset="1" stop-color="{{pink}}" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="wave-back" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="{{cyan}}"/>
      <stop offset="1" stop-color="{{accent}}"/>
    </linearGradient>
    <linearGradient id="wave-mid" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="{{accent}}"/>
      <stop offset="0.55" stop-color="{{purple}}"/>
      <stop offset="1" stop-color="{{pink}}"/>
    </linearGradient>
    <linearGradient id="wave-front" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="{{purple}}"/>
      <stop offset="1" stop-color="{{accent}}"/>
    </linearGradient>
    <!-- Shade laid over a wave: clear at the crest, background colour at the foot. -->
    <linearGradient id="shade" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="{{bg}}" stop-opacity="0"/>
      <stop offset="1" stop-color="{{bg}}" stop-opacity="0.85"/>
    </linearGradient>
    <filter id="grain" x="0" y="0" width="100%" height="100%">
      <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="1" stitchTiles="stitch"/>
      <feColorMatrix type="saturate" values="0"/>
    </filter>
  </defs>

  <rect width="3840" height="2160" fill="url(#base)"/>
  <rect width="3840" height="2160" fill="url(#glow)"/>

  <!-- Back wave: high and faint. -->
  <path opacity="0.28" fill="url(#wave-back)"
        d="M0,1240 C820,940 1420,1340 2280,1020 S3420,560 3840,600 L3840,2160 L0,2160 Z"/>
  <path fill="url(#shade)"
        d="M0,1240 C820,940 1420,1340 2280,1020 S3420,560 3840,600 L3840,2160 L0,2160 Z"/>

  <!-- Middle wave: the main sweep from bottom left to the right edge. -->
  <path opacity="0.8" fill="url(#wave-mid)"
        d="M0,1560 C700,1220 1320,1700 2120,1330 S3300,820 3840,900 L3840,2160 L0,2160 Z"/>
  <path fill="url(#shade)"
        d="M0,1560 C700,1220 1320,1700 2120,1330 S3300,820 3840,900 L3840,2160 L0,2160 Z"/>

  <!-- Front wave: lower and stronger, gives the picture depth. -->
  <path opacity="0.85" fill="url(#wave-front)"
        d="M0,1860 C820,1600 1540,2010 2360,1690 S3420,1360 3840,1440 L3840,2160 L0,2160 Z"/>
  <path fill="url(#shade)"
        d="M0,1860 C820,1600 1540,2010 2360,1690 S3420,1360 3840,1440 L3840,2160 L0,2160 Z"/>

  <!-- Faint highlights along the crests. -->
  <path fill="none" stroke="{{text}}" stroke-opacity="0.12" stroke-width="3"
        d="M0,1560 C700,1220 1320,1700 2120,1330 S3300,820 3840,900"/>
  <path fill="none" stroke="{{text}}" stroke-opacity="0.08" stroke-width="2"
        d="M0,1860 C820,1600 1540,2010 2360,1690 S3420,1360 3840,1440"/>

  <rect width="3840" height="2160" filter="url(#grain)" opacity="0.04"/>
</svg>
